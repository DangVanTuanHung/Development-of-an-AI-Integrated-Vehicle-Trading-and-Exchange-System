# MOTIONX - cấu hình local. Điền giá trị sau dấu =, không commit khóa thật.
# Hướng dẫn: docs/LOCAL_ENV_SETUP.md

# Gemini: https://aistudio.google.com/apikey
GEMINI_AI_ENABLED=true
GEMINI_AI_KEY=
# Giữ tên model hiện có; cần đối chiếu model project của bạn được quyền dùng.
GEMINI_AI_MODEL=gemini-3.6-flash
GEMINI_CONNECT_TIMEOUT_MS=10000
GEMINI_READ_TIMEOUT_MS=60000
GEMINI_VISION_READ_TIMEOUT_MS=60000

# Email: để trống = Mailpit trong Docker, hộp thư local http://localhost:8025.
# Gửi Gmail thật: HOST=smtp.gmail.com, PORT=587, AUTH=true, STARTTLS_ENABLE=true.
# USER=email của bạn; PASS=mật khẩu ứng dụng Google, không phải mật khẩu Gmail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_AUTH=
SMTP_STARTTLS_ENABLE=
AUTH_VERIFICATION_FROM=no-reply@motionx.local

# SMS: lấy tại Twilio Console > Account và Verify > Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# VNPay sandbox: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# JWT: file local đã có secret ngẫu nhiên, không cần xin API key.
APP_JWT_SECRET=

# Tùy chọn S3: để trống giữ MinIO local. Ảnh Marketplace vẫn lưu local.
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_ACCESS_KEY=
APP_STORAGE_S3_SECRET_KEY=
APP_STORAGE_S3_BUCKET=
APP_STORAGE_S3_REGION=
APP_STORAGE_S3_PUBLIC_BASE_URL=
APP_STORAGE_S3_PATH_STYLE_ACCESS=
